&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_def2_tzvp_all
    POTENTIAL_FILE_NAME POTENTIAL 
    &MGRID
      CUTOFF 800
      REL_CUTOFF 80
    &END MGRID

    &QS 
      METHOD GAPW
      EPS_DEFAULT 1.0E-14
      EPS_PGF_ORB 1.0E-14
    &END

    &SCF
      EPS_SCF 1.0E-7
      SCF_GUESS RESTART
      MAX_SCF 1000
      !CHOLESKY OFF
      !ADDED_MOS 100
      !&SMEAR ON
      !  METHOD FERMI_DIRAC
      !  ELECTRONIC_TEMPERATURE [K] 300
      !&END SMEAR
      !&MIXING
      !  METHOD BROYDEN_MIXING
      !  ALPHA 0.1
      !  NBROYDEN 4
      !&END MIXING
    &END SCF

    &XC
      &XC_FUNCTIONAL
        &PBE
	    SCALE_X 0.75
        &END PBE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 0.25
        &SCREENING        
          EPS_SCHWARZ 1.0E-12
          SCREEN_ON_INITIAL_P FALSE
        &END
      &END
    &END XC

    &POISSON
       PERIODIC NONE
       POISSON_SOLVER MULTIPOLE
    &END

    &PRINT
       &MO
          ENERGIES
          &EACH
            QS_SCF 0
          &END EACH
       &END MO
    &END PRINT

  &END DFT

  &PROPERTIES
      &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              14
        EPS_FILTER              1.0E-10
        CUTOFF_RADIUS_RI             11
        REGULARIZATION_MINIMAX      0.0
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  
  &SUBSYS
    &CELL
      PERIODIC NONE
      ABC  50 50 50
      MULTIPLE_UNIT_CELL  1 1 1
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME struc.xyz
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES
      &END
      MULTIPLE_UNIT_CELL  1 1 1
    &END
    &KIND H
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND He
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND Li
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND Be
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND B
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND C
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET def2-TZVP
