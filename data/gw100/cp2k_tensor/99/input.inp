    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      RIRS
  PRINT_LEVEL  MEDIUM
  EXTENDED_FFT_LENGTHS
&END GLOBAL
