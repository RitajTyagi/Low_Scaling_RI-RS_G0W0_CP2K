&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT RIRS
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.0
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
     BASIS_SET_FILE_NAME BASIS_mini_all
     POTENTIAL_FILE_NAME ALL_POTENTIALS
     &MGRID
       CUTOFF 600
       REL_CUTOFF 60
     &END MGRID
     &QS
       EPS_DEFAULT 1.0E-15
       METHOD GAPW
     &END QS
     &SCF
       SCF_GUESS RESTART
       EPS_SCF 1e-7
       MAX_SCF 200
       CHOLESKY OFF
       ADDED_MOS 100
       &SMEAR ON
	 METHOD FERMI_DIRAC
         ELECTRONIC_TEMPERATURE [K] 100
       &END SMEAR
       &MIXING
         METHOD BROYDEN_MIXING
         ALPHA 0.4
	 NBROYDEN 4
       &END MIXING
     &END SCF
       &XC
         &XC_FUNCTIONAL PBE
	 &END XC_FUNCTIONAL
       &END XC
       &POISSON
         PERIODIC NONE
         POISSON_SOLVER MULTIPOLE
	 &MULTIPOLE
	   ANALYTICAL_GTERM T
	 &END MULTIPOLE
       &END POISSON
  &END DFT
  &PROPERTIES
      &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        EPS_FILTER              1.0E-10
        CUTOFF_RADIUS_RI             14
        HEDIN_SHIFT
        &RI_RS
           CUTOFF_RADIUS_RL_AO        6
           CUTOFF_RADIUS_RL_W        30
           &GRID_OPTIMIZATION
               RS_AO_RATIO            8
               CUTOFF_ATOMIC_CLUSTER  3
           &END
        &END
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
&SUBSYS
&CELL
  PERIODIC NONE
  ABC 21.19 80.97 13.55
&END CELL
&TOPOLOGY
  &CENTER_COORDINATES
  &END CENTER_COORDINATES
  COORD_FILE_FORMAT XYZ
  COORD_FILE_NAME struc.xyz
&END TOPOLOGY
  &KIND H
    POTENTIAL ALL
    BASIS_SET ORB aug-SZV-MOLOPT-ae-mini
    BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-ae-mini_tier1
  &END KIND
  &KIND C
    POTENTIAL ALL
    BASIS_SET ORB aug-SZV-MOLOPT-ae-mini
    BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-ae-mini_tier1
  &END KIND
&END SUBSYS
&END FORCE_EVAL

