  gaussian 0 6
  13575.3496820              0.22245814352E-03
   2035.2333680              0.17232738252E-02
    463.22562359             0.89255715314E-02
    131.20019598             0.35727984502E-01
     42.853015891            0.11076259931
     15.584185766            0.24295627626
  gaussian 0 2
