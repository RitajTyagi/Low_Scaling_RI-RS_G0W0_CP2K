# Description: RI Fitting basis for use with aug-cc-pVDZ
#        Role: rifit
#     Version: 1  (Data from Turbomole 7.3)
#----------------------------------------------------------------------
# The default minimal basis should not be included
      include_min_basis .false.
# Use spherical functions?
      pure_gauss .true.
