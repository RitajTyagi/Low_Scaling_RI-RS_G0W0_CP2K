      nucleus             1
      mass                1.00794
  #
      l_hartree           6
  #
      cut_pot             4.0  2.0  1.0
      basis_dep_cutoff    0e-0
  #
      radial_base         24 7.0
      radial_multiplier   6
      angular_grids       specified
