&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_avdz_all
    POTENTIAL_FILE_NAME POTENTIAL 
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS 
      METHOD GAPW
      EPS_DEFAULT 1.0E-15
    &END

    &SCF
      EPS_SCF 1.0E-7
      SCF_GUESS RESTART
      MAX_SCF 200
      CHOLESKY OFF
      ADDED_MOS 100
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 100
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 4
      &END MIXING
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &POISSON
       PERIODIC NONE
       POISSON_SOLVER MULTIPOLE
       &MULTIPOLE
           ANALYTICAL_GTERM T
       &END MULTIPOLE
    &END

  &END DFT

  &PROPERTIES
      &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              60
        EPS_FILTER              1.0E-10
        CUTOFF_RADIUS_RI             12
        HEDIN_SHIFT
        &RI_RS
        &END
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  
  &SUBSYS
    &CELL
      PERIODIC NONE
      ABC 29.19 57.81 36.55
      MULTIPLE_UNIT_CELL  1 1 1
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME struc.xyz
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES
      &END
      MULTIPLE_UNIT_CELL  1 1 1
    &END
    &KIND H
      BASIS_SET aug-cc-pVDZ
      BASIS_SET RI_AUX aug-cc-pVDZ-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND C
      BASIS_SET aug-cc-pVDZ
      BASIS_SET RI_AUX aug-cc-pVDZ-RIFIT
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      RIRS
  PRINT_LEVEL  MEDIUM
&END GLOBAL
