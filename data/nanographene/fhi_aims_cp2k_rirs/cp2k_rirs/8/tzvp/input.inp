&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_def2_tzvp_all
    POTENTIAL_FILE_NAME POTENTIAL 
    &MGRID
      CUTOFF 800
      REL_CUTOFF 80
    &END MGRID

    &QS 
      METHOD GAPW
      EPS_DEFAULT 1.0E-14
      EPS_PGF_ORB 1.0E-14
    &END

    &SCF
      EPS_SCF 1.0E-7
      SCF_GUESS RESTART
      MAX_SCF 1000
      CHOLESKY OFF
      ADDED_MOS 100
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 4
      &END MIXING
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &POISSON
       PERIODIC NONE
       POISSON_SOLVER MULTIPOLE
    &END

    &PRINT
       &MO
          ENERGIES
          &EACH
            QS_SCF 0
          &END EACH
       &END MO
    &END PRINT

  &END DFT

  &PROPERTIES
      &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              14
        EPS_FILTER              1.0E-10
        CUTOFF_RADIUS_RI             12
        EXCLUDE_LIN_DEP_STATES
        &RI_RS
        &END
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  
  &SUBSYS
    &CELL
      PERIODIC NONE
      ABC 29.19 74.86 36.55
      MULTIPLE_UNIT_CELL  1 1 1
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME struc.xyz
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES
      &END
      MULTIPLE_UNIT_CELL  1 1 1
    &END
    &KIND H
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
    &KIND C
      BASIS_SET def2-TZVP
      BASIS_SET RI_AUX def2-TZVP-RIFIT
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      RIRS
  PRINT_LEVEL  MEDIUM
  EXTENDED_FFT_LENGTHS
&END GLOBAL
